    <item>
      <title>Precision Workholding Solutions for Modern Manufacturing</title>
      <link>https://mis3085.github.io/docs-autogrip-machinery/en/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-autogrip-machinery/en/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Advancing Precision in Workholding for Industry 4.0 
    &lt;div id=&#34;advancing-precision-in-workholding-for-industry-40&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
